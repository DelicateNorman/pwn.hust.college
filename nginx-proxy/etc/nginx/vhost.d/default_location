location /internal/ {
    internal;
    set $redirect_uri "$upstream_http_redirect_uri";

    # 本 location 承载经 X-Accel-Redirect 代理的 workspace 内容（code-server、
    # noVNC、挑战容器页面）。这里必须声明自己的 add_header 以阻断对 server 级
    # 安全头（见 vhost.d/default）的继承：平台 CSP 会拦截 code-server 依赖的
    # blob: Web Worker，把整个 VS Code 页面打坏。X-Frame-Options SAMEORIGIN
    # 语义正确：workspace 页面只被平台自身的 iframe 同源嵌入。
    add_header X-Frame-Options "SAMEORIGIN" always;

    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_pass $redirect_uri;

    proxy_ignore_headers X-Accel-Redirect;
}

location = /monitoring {
    return 301 /monitoring/;
}

location /monitoring/ {
    # Grafana 的资源加载策略由其自身管理；声明自己的 add_header 阻断对
    # server 级 CSP 等头的继承（见 vhost.d/default），避免与其内联脚本冲突。
    add_header X-Content-Type-Options "nosniff" always;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;

    # WebSocket
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_cache_bypass $http_upgrade;

    # 超时与缓冲
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_buffering off;
    proxy_http_version 1.1;

    # Resolve "grafana" at request time (via a variable) instead of at reload:
    # grafana runs behind the 'monitoring' compose profile, and a static
    # proxy_pass makes nginx resolve the hostname on every reload, which fails
    # with 'host not found in upstream "grafana"' when the profile is disabled.
    # With a variable, reload always succeeds; this path returns 502 while
    # grafana is not running and works normally once the profile is enabled.
    set $grafana_upstream grafana;
    proxy_pass http://$grafana_upstream:3000/monitoring/;
}

location /nginx_status {
    stub_status;
    allow all;
}